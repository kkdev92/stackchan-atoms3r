# What PlatformIO builds.
/.pio/

# The generated sdkconfig. The fragments in src/config/ are the source of
# truth; this is derived from them. Editing a fragment while a stale
# generated file exists changes nothing, silently, which is what
# tools/sync-sdkconfig.py exists to prevent.
/sdkconfig.*

# What the component manager downloads. Ignored the same way ESP-IDF itself
# is; dependencies.lock is committed instead, which pins both the versions
# and their hashes.
/managed_components/

# Python
__pycache__/
*.pyc

# Editors.
#
# .vscode/extensions.json is committed on purpose: it recommends the one
# extension this project needs, and says the same thing on every machine.
#
# The remaining .vscode files are generated by PlatformIO, may contain absolute
# local paths, and can be regenerated on demand.
compile_commands.json
.vscode/.browse.c_cpp.db*
.vscode/ipch/
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/tasks.json
.vscode/settings.json

# Local Claude Code setup. The skills and MCP server definitions here are
# per-machine tooling rather than part of the firmware, and .mcp.json can carry
# local paths and credentials.
/.claude/
/.mcp.json

# Where Playwright drops traces, videos, screenshots and browser profiles from
# local runs. .playwright-cli/ is the working directory of the playwright-cli
# tool and holds page snapshots and a persistent browser profile.
/.playwright/
/.playwright-cli/

# Common local secrets and logs. Review staged changes before committing, and
# redact credentials and setup details before sharing device logs.
secrets.local.*
.env
*.pem
*.key
*.log

# Local working files.
/work/
